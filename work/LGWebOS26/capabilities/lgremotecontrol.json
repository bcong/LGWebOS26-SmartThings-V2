                    "value": {
                        "type": "string"
                    }
                },
                "required": ["value"],
                "additionalProperties": false
            },
            "setter": "setInputSource",
            "enumCommands": []
        },
        "supportedInputSources": {
            "schema": {
                "type": "object",
