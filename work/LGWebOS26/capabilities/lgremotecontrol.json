                            "VOLUMEDOWN",
                            "PLAY",
                            "PAUSE",
                            "STOP",
                            "REWIND",
                            "FASTFORWARD",
                            "ASTERISK",
                            "BACK",
                            "EXIT",
                            "ENTER",
                            "AMAZON",
                            "NETFLIX",
                            "DISNEY_PLUS",
                            "COUPANG_PLAY",
                            "TVING",
                            "LAFTEL",
                            "3D_MODE",
                            "AD",
                            "ASPECT_RATIO",
                            "CC",
                            "DASH",
                            "GUIDE",
                            "HOME",
